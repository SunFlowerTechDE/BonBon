# Kopie anlegen als .env  —  .env wird nie committet (siehe .gitignore)
#
# fiskaltrust Sandbox, Rolle KassenHersteller.
# Beide Werte stehen im fiskaltrust Portal unter der jeweiligen Cashbox.
FISKALTRUST_CASHBOX_ID=
FISKALTRUST_ACCESS_TOKEN=

# Basis-URL der Queue des lokal laufenden Launchers.
# Zu finden im Portal unter Configuration -> Queue: den Listeneintrag
# aufklappen und die URL kopieren. Sie hat das Schema rest:// und wird fuer
# HTTP zu http:// — der Spike rechnet das selbst um.
# Beispiel: rest://localhost:1500/f84bf516-a17b-4432-afa6-8c1050e2854d
FISKALTRUST_URL=

# Optional, Vorgabe 30000.
FISKALTRUST_TIMEOUT_MS=
